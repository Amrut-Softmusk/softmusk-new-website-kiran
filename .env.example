# Copy to .env.local (local) or set in your hosting panel (production). Never commit real values.

# Public site URL (used for canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.softmusk.com

# Website forms → email (https://www.emailjs.com), sent from the server; keys never reach the browser.
# EmailJS dashboard: Email Services (service ID), Email Templates (template ID), Account → General (keys).
# Also turn on Account → Security → "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=softmusk_contact
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Max CV upload in KB. 0 = CV uploads off (EmailJS free plan has no attachments).
EMAILJS_ATTACHMENT_MAX_KB=0
# Inbox that receives form submissions (defaults to service@softmusk.com)
ENQUIRY_TO=

# Optional search console verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
