# Copy to .env.local (local) or set in your hosting panel (production). Never commit real values.

# Public site URL (used for canonical links, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://www.softmusk.com

# Website forms → email (https://resend.com)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Softmusk Website <website@softmusk.com>"
ENQUIRY_FROM=
# Inbox that receives form submissions (defaults to service@softmusk.com)
ENQUIRY_TO=

# Optional search console verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
